# Django Secret Key
SECRET_KEY=your-django-insecure-secret-key-here

# Debug Mode
DEBUG=True

# wkhtmltopdf Binary Path (needed for medical reports PDF generation)
# On macOS: /usr/local/bin/wkhtmltopdf or /opt/homebrew/bin/wkhtmltopdf
# On Linux: /usr/bin/wkhtmltopdf
WKHTMLTOPDF_BIN=wkhtmltopdf
PDF_FONT_DIR=/usr/share/fonts

# Database Configuration (if using PostgreSQL)
# DB_NAME=niqabaty
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password-here
DEFAULT_FROM_EMAIL=your-email@example.com
