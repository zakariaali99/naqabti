# Deployment Configuration
# Copy this file to .env.deploy and fill in your remote server credentials.

# Remote server host/IP
DEPLOY_HOST=my.naqabti.ly

# Remote server SSH user
DEPLOY_USER=naqabtil

# Remote server SSH port (default is 22)
DEPLOY_PORT=22

# Remote target folder path where the backend/ files will be deployed
DEPLOY_PATH=/home/naqabtil/niqabaty/backend
