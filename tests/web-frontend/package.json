{
  "name": "web-frontend",
  "version": "1.0.0",
  "description": "End-to-end tests for the Niqabty web frontend, run against a real Django backend",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:journeys": "playwright test tests/journeys --project=chromium",
    "test:auth": "playwright test tests/auth --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "e2e", "testing"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.0",
    "typescript": "^5.6.3"
  }
}
